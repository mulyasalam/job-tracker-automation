# ===== Database =====
DATABASE_URL=file:./sqlite.db

# ===== Better Auth =====
# Generate with: openssl rand -base64 32   (or any 32+ char random string)
BETTER_AUTH_SECRET=replace-with-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# ===== Google OAuth (Gmail read-only) =====
# Get from: https://console.cloud.google.com/apis/credentials
# 1) Create OAuth 2.0 Client ID (Web application)
# 2) Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 3) Enable Gmail API on the same project: https://console.cloud.google.com/apis/library/gmail.googleapis.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Gemini =====
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== Inngest =====
# For local dev: leave blank and run `npm run inngest:dev` in a second terminal.
# For production: get keys from https://app.inngest.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
